// --- Api.gs ---
function doGet(e) {
  if(e && e.parameter && e.parameter.mode==='setup'){
    try{reviewer_(true);return HtmlService.createTemplate(html_('Setup')).evaluate().setTitle('Configurar UMA · Google Workspace').addMetaTag('viewport','width=device-width, initial-scale=1');}catch(error){return HtmlService.createHtmlOutput('<p>Solo la cuenta propietaria puede configurar el sistema.</p>');}
  }
  if(e && e.parameter && e.parameter.mode==='bridge'){
    try{return bridgePage_(e);}catch(error){return HtmlService.createHtmlOutput('<p>Conexión no autorizada. Abra el panel de Google con una cuenta de Tesorería.</p>');}
  }
  try{reviewer_();return HtmlService.createTemplate(html_('Dashboard')).evaluate().setTitle('UMA · Descuentos corporativos').addMetaTag('viewport','width=device-width, initial-scale=1');}
  catch(e){return HtmlService.createHtmlOutput('<!doctype html><html lang="es"><meta charset="utf-8"><title>Acceso restringido</title><body style="font:18px Arial;padding:48px"><h1>UMA · Acceso restringido</h1><p>'+escapeHtml_(e.message)+'</p></body></html>');}
}
function html_(name){return typeof UMA_UI_!=='undefined'?UMA_UI_[name]:HtmlService.createHtmlOutputFromFile(name).getContent();}
function include_(name){return html_(name);}
function getBootstrap() {
  var actor=reviewer_(),c=config_();return {actor:actor,isAdmin:actor===UMA.owner,owner:UMA.owner,period:c.ACADEMIC_PERIOD,schools:UMA.schools,discounts:UMA.discounts,categories:UMA.categories,states:UMA.states,emailEnabled:c.EMAIL_NOTIFICATION_ENABLED==='true',domains:c.INSTITUTIONAL_EMAIL_DOMAINS,spreadsheet:'https://docs.google.com/spreadsheets/d/'+c.SPREADSHEET_ID+'/edit',studentForm:FormApp.openById(c.GOOGLE_FORM_ID).getPublishedUrl()};
}
function listApplications(filter,page,pageSize) {
  reviewer_();var all=rows_('Solicitudes'),selected=filtered_(all,filter),size=Math.min(100,Math.max(10,Number(pageSize)||20)),p=Math.max(1,Number(page)||1);
  return {rows:selected.slice((p-1)*size,p*size),total:selected.length,page:p,pageSize:size,stats:statistics_(all,rows_('Correos'))};
}
function getApplication(id) {
  reviewer_();var a=application_(id);return {application:a,documents:rows_('Documentos').filter(function(d){return d.applicationId===id;}),history:rows_('Historial_Estados').filter(function(h){return h.applicationId===id;}),observations:rows_('Observaciones').filter(function(o){return o.applicationId===id;}),emails:rows_('Correos').filter(function(m){return m.applicationId===id;}).map(publicEmail_)};
}
function publicEmail_(m){var safe=Object.assign({},m);delete safe.body;return safe;}
function listEmails(){reviewer_();return rows_('Correos').slice(-300).reverse().map(publicEmail_);}
function listAudit(){reviewer_(true);return {audit:rows_('Auditoria').slice(-200).reverse(),errors:rows_('Errores').slice(-100).reverse()};}
function updateSettings(settings){var actor=reviewer_(true);return locked_(function(){
  assert_(settings&&typeof settings==='object','Configuración inválida');var p=properties_();
  if(settings.emailEnabled!==undefined)p.setProperty('EMAIL_NOTIFICATION_ENABLED',settings.emailEnabled===true?'true':'false');
  if(settings.domains!==undefined){var d=String(settings.domains).split(',').map(function(s){return s.trim().toLowerCase();}).filter(Boolean);assert_(d.every(function(s){return /^[a-z0-9.-]+\.[a-z]{2,}$/.test(s);}), 'Dominios inválidos');p.setProperty('INSTITUTIONAL_EMAIL_DOMAINS',d.join(','));}
  audit_(actor,'SETTINGS_UPDATED','','Notificaciones/dominios');return {ok:true};
});}


// --- Bridge.gs ---
/** A narrow RPC surface for the Render static frontend. Never executes arbitrary names. */
function bridgeCall(request) {
  reviewer_();
  assert_(request && typeof request === 'object', 'Solicitud de conexión inválida');
  assert_(allowedFrontend_(request.origin), 'Sitio de Tesorería no autorizado');
  var args = request.args || [];
  assert_(Array.isArray(args) && args.length <= 4, 'Argumentos inválidos');
  var methods = {
    getBootstrap:getBootstrap, listApplications:listApplications, getApplication:getApplication,
    listEmails:listEmails, listAudit:listAudit, updateSettings:updateSettings,
    saveDecision:saveDecision, setReviewStatus:setReviewStatus, renewCorrection:renewCorrection,
    resolveEmail:resolveEmail, exportExcel:exportExcel, runSystemHealthCheck:runSystemHealthCheck
  };
  assert_(Object.prototype.hasOwnProperty.call(methods,request.method), 'Operación no permitida');
  return methods[request.method].apply(null,args);
}
function allowedFrontend_(origin) {
  if(typeof origin !== 'string' || !/^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(origin))return false;
  return String(config_().FRONTEND_ORIGINS||'').split(',').map(function(v){return v.trim();}).indexOf(origin)>=0;
}
function bridgePage_(e) {
  reviewer_();
  var origin=String(e.parameter.origin||''),channel=String(e.parameter.channel||'');
  assert_(allowedFrontend_(origin),'Origen del panel no autorizado');
  assert_(/^[a-f0-9]{64}$/.test(channel),'Canal de conexión inválido');
  var t=HtmlService.createTemplate(html_('Bridge'));
  t.settings=JSON.stringify({origin:origin,channel:channel}).replace(/</g,'\\u003c');
  return t.evaluate().setTitle('UMA · Conexión protegida').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}


