// --- Api.gs ---
function doPost(e){
  var response;
  try{
    assert_(e&&e.postData&&typeof e.postData.contents==='string'&&e.postData.contents.length<=1048576,'Petición inválida');
    assert_(config_().MANAGEMENT_AUTH_ENABLED==='true','El acceso de gestión no está configurado');
    response={ok:true,result:bridgeCall(JSON.parse(e.postData.contents))};
  }catch(error){response={ok:false,error:String(error.message||'No se pudo procesar la solicitud')};}
  return ContentService.createTextOutput(JSON.stringify(response)).setMimeType(ContentService.MimeType.JSON);
}
function doGet(e) {
  if(e && e.parameter && e.parameter.mode==='setup'){
    try{setupOwner_();return HtmlService.createTemplate(html_('Setup')).evaluate().setTitle('Configurar UMA · Google Workspace').addMetaTag('viewport','width=device-width, initial-scale=1');}catch(error){return HtmlService.createHtmlOutput('<p>Solo la cuenta propietaria puede configurar el sistema.</p>');}
  }
  if(e && e.parameter && e.parameter.mode==='bridge'){
    try{return bridgePage_(e);}catch(error){return HtmlService.createHtmlOutput('<p>Origen de conexión no autorizado.</p>');}
  }
  var origin=String(config_().FRONTEND_ORIGINS||'').split(',')[0];
  return HtmlService.createHtmlOutput('<!doctype html><html lang="es"><meta charset="utf-8"><title>Tesorería UMA</title><body style="font:18px Arial;padding:48px"><h1>Tesorería UMA</h1><p><a href="'+escapeHtml_(allowedFrontend_(origin)?origin:'#')+'">Abrir plataforma de gestión</a></p></body></html>');
}
function html_(name){return typeof UMA_UI_!=='undefined'?UMA_UI_[name]:HtmlService.createHtmlOutputFromFile(name).getContent();}
function include_(name){return html_(name);}
function getBootstrap() {
  var actor=reviewer_(),c=config_();return {actor:actor,isAdmin:actor===UMA.owner||!!UMA_REQUEST_AUTH_,owner:UMA.owner,period:c.ACADEMIC_PERIOD,schools:UMA.schools,discounts:UMA.discounts,categories:UMA.categories,states:UMA.states,emailEnabled:c.EMAIL_NOTIFICATION_ENABLED==='true',domains:c.INSTITUTIONAL_EMAIL_DOMAINS,spreadsheet:'https://docs.google.com/spreadsheets/d/'+c.SPREADSHEET_ID+'/edit',studentForm:FormApp.openById(c.GOOGLE_FORM_ID).getPublishedUrl()};
}
function listApplications(filter,page,pageSize) {
  reviewer_();var all=rows_('Solicitudes'),selected=filtered_(all,filter),size=Math.min(100,Math.max(10,Number(pageSize)||20)),p=Math.max(1,Number(page)||1);
  return {rows:selected.slice((p-1)*size,p*size),total:selected.length,page:p,pageSize:size,stats:statistics_(all,rows_('Correos'))};
}
function getApplication(id) {
  reviewer_();var a=application_(id);return {application:a,documents:rows_('Documentos').filter(function(d){return d.applicationId===id;}),history:rows_('Historial_Estados').filter(function(h){return h.applicationId===id;}),observations:rows_('Observaciones').filter(function(o){return o.applicationId===id;}),emails:rows_('Correos').filter(function(m){return m.applicationId===id;}).map(publicEmail_)};
}
function publicEmail_(m){var safe=Object.assign({},m);delete safe.body;return safe;}
function listEmails(){reviewer_();return rows_('Correos').slice(-300).reverse().map(publicEmail_);}
function listAudit(){reviewer_(true);return {audit:rows_('Auditoria').slice(-200).reverse(),errors:rows_('Errores').slice(-100).reverse()};}
function updateSettings(settings){var actor=reviewer_(true);return locked_(function(){
  assert_(settings&&typeof settings==='object','Configuración inválida');var p=properties_();
  if(settings.emailEnabled!==undefined)p.setProperty('EMAIL_NOTIFICATION_ENABLED',settings.emailEnabled===true?'true':'false');
  if(settings.domains!==undefined){var d=String(settings.domains).split(',').map(function(s){return s.trim().toLowerCase();}).filter(Boolean);assert_(d.every(function(s){return /^[a-z0-9.-]+\.[a-z]{2,}$/.test(s);}), 'Dominios inválidos');p.setProperty('INSTITUTIONAL_EMAIL_DOMAINS',d.join(','));}
  audit_(actor,'SETTINGS_UPDATED','','Notificaciones/dominios');return {ok:true};
});}


// --- Auth.gs ---
// Management authentication. Credentials and session verifiers stay in Google Script Properties/Cache.
var UMA_REQUEST_AUTH_ = null;
function setupOwner_(){
  effectiveOwner_();assert_(normalizeEmail_(Session.getActiveUser().getEmail())===UMA.owner,'Solo la cuenta propietaria puede realizar la configuración de Google.');
}
function digest_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value),Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');}
function equalSecret_(a,b){a=String(a||'');b=String(b||'');var result=a.length^b.length;for(var i=0;i<Math.max(a.length,b.length);i++)result|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return result===0;}
function configureManagementAccess(input){
  setupOwner_();assert_(input&&/^[A-Za-z0-9._-]{3,40}$/.test(input.username)&&/^[a-f0-9]{32}$/.test(input.salt)&&/^[a-f0-9]{64}$/.test(input.proof),'Datos de acceso inválidos');
  assert_(Number(input.iterations)===600000,'Derivación de contraseña inválida');
  return locked_(function(){var p=properties_();p.setProperty('MANAGEMENT_USERNAME',input.username);p.setProperty('MANAGEMENT_SALT',input.salt);p.setProperty('MANAGEMENT_ITERATIONS','600000');p.setProperty('MANAGEMENT_VERIFIER',digest_(input.proof));p.setProperty('MANAGEMENT_CREDENTIAL_VERSION',Utilities.getUuid());p.setProperty('MANAGEMENT_AUTH_ENABLED','true');audit_(UMA.owner,'MANAGEMENT_ACCESS_CONFIGURED','','Usuario y contraseña configurados');return {configured:true,username:input.username};});
}
function managementAuthParameters_(){
  var c=config_();assert_(c.MANAGEMENT_AUTH_ENABLED==='true'&&c.MANAGEMENT_VERIFIER,'El administrador debe configurar el usuario y contraseña');
  return {salt:c.MANAGEMENT_SALT,iterations:Number(c.MANAGEMENT_ITERATIONS)};
}
function loginManagement_(input){
  managementAuthParameters_();assert_(input&&typeof input.username==='string'&&typeof input.proof==='string'&&input.username.length<=40&&/^[a-f0-9]{64}$/.test(input.proof),'Usuario o contraseña incorrectos');
  return locked_(function(){
    var cache=CacheService.getScriptCache(),key='UMA_LOGIN_FAILURES',failed=Number(cache.get(key)||0),c=config_();
    assert_(failed<10,'Demasiados intentos. Espere 15 minutos y vuelva a intentar.');
    var valid=equalSecret_(digest_(input.proof),c.MANAGEMENT_VERIFIER),correctUser=equalSecret_(input.username,c.MANAGEMENT_USERNAME);
    if(!valid||!correctUser){cache.put(key,String(failed+1),900);throw new Error('Usuario o contraseña incorrectos');}
    cache.remove(key);var token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''),expiresAt=Date.now()+21600000;
    cache.put('UMA_SESSION_'+digest_(token),JSON.stringify({username:c.MANAGEMENT_USERNAME,admin:true,expiresAt:expiresAt,version:c.MANAGEMENT_CREDENTIAL_VERSION}),21600);
    audit_('gestión:'+c.MANAGEMENT_USERNAME,'AUTH_LOGIN','','Ingreso al panel');return {token:token,expiresAt:expiresAt};
  });
}
function managementSession_(token){
  assert_(typeof token==='string'&&/^[a-f0-9]{64}$/.test(token),'AUTH_REQUIRED: Inicie sesión para continuar.');
  var record=CacheService.getScriptCache().get('UMA_SESSION_'+digest_(token)),session=record&&JSON.parse(record),c=config_();
  assert_(c.MANAGEMENT_AUTH_ENABLED==='true'&&session&&session.expiresAt>Date.now()&&session.version===c.MANAGEMENT_CREDENTIAL_VERSION,'AUTH_REQUIRED: Su sesión terminó. Ingrese nuevamente.');return session;
}
function withManagementSession_(token,callback){
  assert_(!UMA_REQUEST_AUTH_,'Contexto de acceso inválido');UMA_REQUEST_AUTH_=managementSession_(token);
  try{return callback();}finally{UMA_REQUEST_AUTH_=null;}
}
function logoutManagement_(token){var actor=reviewer_();CacheService.getScriptCache().remove('UMA_SESSION_'+digest_(token));audit_(actor,'AUTH_LOGOUT','','Salida del panel');return {ok:true};}
function getDocumentFile(applicationId,fileId){
  var actor=reviewer_();application_(applicationId);var doc=rows_('Documentos').find(function(d){return d.applicationId===applicationId&&d.fileId===fileId;});
  assert_(doc,'El documento no pertenece a este expediente');var file=DriveApp.getFileById(doc.fileId),mime=file.getMimeType();
  assert_(['application/pdf','image/jpeg','image/png'].indexOf(mime)>=0&&file.getSize()<=Number(config_().MAX_FILE_BYTES),'Archivo no permitido');
  audit_(actor,'DOCUMENT_OPENED',applicationId,doc.name);return {name:doc.name,mimeType:mime,data:Utilities.base64Encode(file.getBlob().getBytes())};
}


// --- Bridge.gs ---
/** A narrow RPC surface for the Render static frontend. Never executes arbitrary names. */
function bridgeCall(request) {
  assert_(request && typeof request === 'object', 'Solicitud de conexión inválida');
  assert_(allowedFrontend_(request.origin), 'Sitio de Tesorería no autorizado');
  if(request.method==='managementAuthParameters')return managementAuthParameters_();
  if(request.method==='loginManagement')return loginManagement_(request.args&&request.args[0]);
  var args = request.args || [];
  assert_(Array.isArray(args) && args.length <= 4, 'Argumentos inválidos');
  var methods = {
    getBootstrap:getBootstrap, listApplications:listApplications, getApplication:getApplication,
    listEmails:listEmails, listAudit:listAudit, updateSettings:updateSettings,
    saveDecision:saveDecision, setReviewStatus:setReviewStatus, renewCorrection:renewCorrection,
    resolveEmail:resolveEmail, exportExcel:exportExcel, runSystemHealthCheck:runSystemHealthCheck,
    getDocumentFile:getDocumentFile,logoutManagement:function(){return logoutManagement_(request.token);}
  };
  assert_(Object.prototype.hasOwnProperty.call(methods,request.method), 'Operación no permitida');
  if(config_().MANAGEMENT_AUTH_ENABLED!=='true'){reviewer_();return methods[request.method].apply(null,args);}
  return withManagementSession_(request.token,function(){return methods[request.method].apply(null,args);});
}
function allowedFrontend_(origin) {
  if(typeof origin !== 'string' || !/^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(origin))return false;
  return String(config_().FRONTEND_ORIGINS||'').split(',').map(function(v){return v.trim();}).indexOf(origin)>=0;
}
function bridgePage_(e) {
  var origin=String(e.parameter.origin||''),channel=String(e.parameter.channel||'');
  assert_(allowedFrontend_(origin),'Origen del panel no autorizado');
  assert_(/^[a-f0-9]{64}$/.test(channel),'Canal de conexión inválido');
  var t=HtmlService.createTemplate(html_('Bridge'));
  t.settings=JSON.stringify({origin:origin,channel:channel}).replace(/</g,'\\u003c');
  return t.evaluate().setTitle('UMA · Conexión protegida').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}


