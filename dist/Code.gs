ud');if(applicationId){try{await openDetail(applicationId);if(linked.get('documento'))await previewDocument(linked.get('documento'));}catch(error){handle(error);}}\r\n}\r\n$('navigation').onclick=e=>{const button=e.target.closest('[data-view]');if(button)navigate(button.dataset.view).catch(handle);};\r\nfunction closeMenu(){const open=document.querySelector('.sidebar').classList.contains('open');document.querySelector('.sidebar').classList.remove('open');$('mobileMenu').setAttribute('aria-expanded','false');if(open&&matchMedia('(max-width:850px)').matches)$('mobileMenu').focus();}\r\n$('mobileMenu').onclick=()=>{const open=document.querySelector('.sidebar').classList.toggle('open');$('mobileMenu').setAttribute('aria-expanded',String(open));};\r\n$('menuBackdrop').onclick=closeMenu;document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu();});\r\n$('refresh').onclick=()=>navigate(view).catch(handle);\r\n$('filters').onsubmit=e=>{e.preventDefault();page=1;loadApplications().catch(handle);};\r\n$('search').oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>{page=1;loadApplications().catch(handle);},300);};\r\n['statusFilter','discountFilter','schoolFilter','fromFilter','toFilter'].forEach(id=>$(id).onchange=()=>{page=1;loadApplications().catch(handle);});\r\n$('advancedToggle').onclick=()=>{const hidden=$('advancedFilters').classList.toggle('hidden');$('advancedToggle').setAttribute('aria-expanded',String(!hidden));};\r\n$('clearFilters').onclick=()=>{['search','statusFilter','discountFilter','schoolFilter','fromFilter','toFilter'].forEach(id=>$(id).value='');page=1;loadApplications().catch(handle);};\r\n$('prevPage').onclick=()=>{page--;loadApplications().catch(handle);};$('nextPage').onclick=()=>{page++;loadApplications().catch(handle);};\r\n$('closeDetail').onclick=()=>$('detailDialog').close();$('cancelDecision').onclick=()=>$('confirmDialog').close();$('confirmDecision').onclick=confirmDecision;\r\n$('detailDialog').addEventListener('cl