or);}};\r\n$('healthRefresh').onclick=()=>loadHealth().catch(handle);\r\nif(window.UMA_REMOTE)window.UMA_REMOTE.start(init);else init().catch(handle);\r\n})();\r\n</script>\r\n","Dashboard":"<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head><base target=\"_top\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>UMA · Descuentos corporativos</title><?!= include_('Styles'); ?></head>\r\n<body>\r\n<a class=\"skip\" href=\"#main\">Ir al contenido</a>\r\n<div class=\"app\">\r\n  <aside class=\"sidebar\" aria-label=\"Navegación principal\">\r\n    <div class=\"brand\"><img src=\"<?!= include_('Logo'); ?>\" alt=\"UMA · Universidad María Auxiliadora\" width=\"208\" height=\"97\"></div>\r\n    <div class=\"workspace\">ÁREA DE TESORERÍA<span id=\"period\">2027-I</span></div>\r\n    <nav id=\"navigation\" aria-label=\"Gestión de solicitudes\"><span class=\"nav-label\">EXPEDIENTES</span>\r\n      <button class=\"nav active\" data-view=\"overview\" aria-current=\"page\"><span class=\"ui-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg></span>Resumen</button>\r\n      <button class=\"nav\" data-view=\"applications\"><span class=\"ui-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" focusable=\"false\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/></svg></span>Todas las solicitudes<span class=\"nav-count\" id=\"navTotal\">0</span></button>\r\n      <button class=\"nav\" data-view=\"pending\"><span c