rado y notificación en cola.');}\n    if(resolve){const note=prompt(resolve.dataset.resolution==='REQUEUE'?'Tras comprobar que el mensaje no fue enviado, documente la verificación. Reintentar puede duplicarlo si ya fue aceptado.':'Documente cómo comprobó que el mensaje fue enviado.');if(note){await api('resolveEmail',resolve.dataset.resolve,resolve.dataset.resolution,note);await loadEmails();}}\n  }catch(error){handle(error);}\n});\n$('export').onclick=async()=>{const button=$('export');button.disabled=true;try{const result=await api('exportExcel',filters());toast(`Excel generado: ${result.count} solicitudes.`);const a=document.createElement('a');a.href=safeUrl(result.url);a.target='_blank';a.rel='noopener';a.textContent='Abrir Excel en Google Drive';$('toast').append(document.createElement('br'),a);a.style.color='white';}catch(e){handle(e);}finally{button.disabled=false;}};\n$('settingsForm').onsubmit=async e=>{e.preventDefault();try{await api('updateSettings',{emailEnabled:$('emailEnabled').checked,domains:$('domains').value});boot.emailEnabled=$('emailEnabled').checked;$('pausedBanner').classList.toggle('hidden',boot.emailEnabled);toast('Configuración guardada.');}catch(error){handle(error);}};\n$('healthRefresh').onclick=()=>loadHealth().catch(handle);\ninit().catch(error=>{handle(error);$('applicationRows').innerHTML='<tr><td colspan=\"6\" class=\"empty\">No se pudo conectar con Google. Revise la autorización y el despliegue.</td></tr>';});\n})();\n</script>\n","Dashboard":"<!DOCTYPE html>\n<html lang=\"es\">\n<head><base target=\"_top\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>UMA · Descuentos corporativos</title><?!= include_('Styles'); ?></head>\n<body>\n<a class=\"skip\" href=\"#main\">Ir al contenido</a>\n<div class=\"app\">\n  <aside class=\"sidebar\" aria-label=\"Navegación principal\">\n    <div class=\"brand\"><img src=\"<?!= include_('Logo'); ?>\" alt=\"UMA · Universidad María Auxiliadora\" 