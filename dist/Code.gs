function configureWorkspace(input){
  owner_();assert_(input&&allowedOriginInput_(input.origin),'Indique el origen HTTPS exacto del sitio Render');
  return locked_(function(){
    var p=properties_(),c=config_();assert_(c.ROOT_DRIVE_FOLDER_ID,'Inicialice los recursos primero');
    p.setProperty('FRONTEND_ORIGINS',input.origin);p.setProperty('TEMPLATE_PDF_URL',input.origin+'/ficha-socioeconomica-2027-I.pdf');
    if(input.template||!c.TEMPLATE_PDF_FILE_ID){
      var bytes;
      if(input.template){assert_(typeof input.template.data==='string'&&input.template.data.length<7*1024*1024,'Archivo demasiado grande');bytes=Utilities.base64Decode(input.template.data);}
      else {var response=UrlFetchApp.fetch(input.origin+'/ficha-socioeconomica-2027-I.pdf',{muteHttpExceptions:true});assert_(response.getResponseCode()===200,'No se pudo importar el PDF original publicado en Render');bytes=response.getBlob().getBytes();}
      assert_(bytes.length>=5&&bytes.length<=5*1024*1024&&String.fromCharCode.apply(null,bytes.slice(0,5))==='%PDF-','El archivo no es un PDF válido de hasta 5 MB');
      var folder=restrictedFolder_(DriveApp.getFolderById(c.ROOT_DRIVE_FOLDER_ID),'Plantilla_original');
      var file=folder.createFile(Utilities.newBlob(bytes,'application/pdf','Ficha_Socioeconomica_2027-I_original.pdf'));
      file.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);p.setProperty('TEMPLATE_PDF_FILE_ID',file.getId());
    }
    audit_(UMA.owner,'WORKSPACE_CONFIGURED','','Origen de Render y ficha original');
    c=config_();return {origin:input.origin,templateFileId:c.TEMPLATE_PDF_FILE_ID||'',templateDownload:c.TEMPLATE_PDF_URL,applicationFormUrl:FormApp.openById(c.GOOGLE_FORM_ID).getPublishedUrl(),correctionFormEditUrl:FormApp.openById(c.CORRECTION_FORM_ID).getEditUrl(),applicationFormEditUrl:FormApp.openById(c.GOOGLE_FORM_ID).getEditUrl(),next:'Añada las preguntas nativas de carga en ambos formularios y ejecute finalizeSetup.'};
  });
}
function allowedOriginInput_(origin){return typeof origin==='string'&&/^https:\/\/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::\d+)?$/i.test(origin);}
function privacyNotice_(){return config_().PRIVACY_NOTICE||'Sus datos y documentos serán revisados por el Área de Tesorería de la Universidad María Auxiliadora para gestionar esta solicitud de descuento corporativo. Los documentos se mantienen con acceso restringido al personal autorizado. Consulte a UMA sobre el tratamiento, conservación de sus datos y ejercicio de sus derechos.';}


// --- Store.gs ---
function book_() { var id=config_().SPREADSHEET_ID; assert_(id,'Ejecute initializeProject primero'); return SpreadsheetApp.openById(id); }
function table_(name) { var s=book_().getSheetByName(name);assert_(s,'Falta la hoja '+name);return s; }
function rows_(name) {
  var s=table_(name), values=s.getDataRange().getValues(), h=values.shift();
  return values.filter(function(r){return r[0]!=='';}).map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i] instanceof Date?r[i].toISOString():r[i];});return o;});
}
function put_(name, record, keyField) {
  keyField=keyField||'key';var s=table_(name), values=s.getDataRange().getValues(),h=values[0], k=h.indexOf(keyField);
  assert_(k>=0,'Columna clave ausente'); var n=values.findIndex(function(r,i){return i>0&&String(r[k])===String(record[keyField]);});
  var row=h.map(function(field,i){return Object.prototype.hasOwnProperty.call(record,field)?sheetValue_(record[field]):(n>=0?values[n][i]:'');});
  s.getRange(n<0?s.getLastRow()+1:n+1,1,1,h.length).setValues([row]);return record;
}
function append_(name, record) { var s=table_(name),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(function(k){return sheetValue_(record[k]);}));return record; }
function find_(name,key,value) { return rows_(name).find(function(r){return String(r[key])===String(value);}); }
function application_(id) {var a=find_('Solicitudes','id',id);assert_(a,'Solicitud no encontrada');return a;}
function saveApplication_(a) {a.updatedAt=now_();put_('Solicitudes',a,'id');return a;}
function transition_(a,status,actor,detail,key) {
  var old=a.status; a.status=status;
  var eventKey=key||Utilities.getUuid();
  if(!find_('Historial_Estados','key',eventKey))append_('Historial_Estados',{key:eventKey,applicationId:a.id,fromStatus:old,toStatus:status,reviewer:actor,timestamp:now_(),detail:detail||''});
}
function nextId_() {
  var p=properties_(),year=config_().ACADEMIC_PERIOD.slice(0,4),key='SEQUENCE_'+year;
  var n=Number(p.getProperty(key)||0)+1;p.setProperty(key,String(n));return 'UMA-DC-'+year+'-'+String(n).padStart(6,'0');
}


// --- Submissions.gs ---
function readResponse_(response, correction) {
  var map=JSON.parse(config_()[correction?'CORRECTION_QUESTION_MAP':'QUESTION_MAP']||'{}'),byId={};
  response.getItemResponses().forEach(function(ir){byId[String(ir.getItem().getId())]=ir.getResponse();});
  var values={};Object.keys(map).forEach(function(k){values[k]=byId[map[k]]||'';});
  function files(k){var v=values[k];return (Array.isArray(v)?v:v?[v]:[]).map(String);}
  return {values:values,uploads:{socioeconomic:files('socioeconomic'),supporting:files('supporting')}};
}
function validateTrigger_(e, handler, formKey) {
  owner_(e,handler);assert_(e&&e.response&&e.source&&String(e.source.getId())===config_()[formKey]&&String(e.triggerUid)===properties_().getProperty('TRIGGER_'+handler),'Evento de formulario no autorizado');
}
function onApplicationSubmit(e){validateTrigger_(e,'onApplicationSubmit','GOOGLE_FORM_ID');return ingest_(e.response,false);}
function onCorrectionSubmit(e){validateTrigger_(e,'onCorrectionSubmit','CORRECTION_FORM_ID');return ingest_(e.response,true);}
function ingest_(response,correction) {
  effectiveOwner_();return locked_(function(){
    var cfg=config_(),formId=cfg[correction?'CORRECTION_FORM_ID':'GOOGLE_FORM_ID'],key=formId+':'+response.getId();
    var event=find_('Eventos','key',key);if(event&&event.status==='DONE')return event.applicationId;
    event=event||{key:key,formId:formId,responseId:response.getId(),timestamp:now_(),status:'PROCESSING'};
    event.attempts=Number(event.attempts||0)+1;event.attemptedAt=now_();
    try{
      var data=readResponse_(response,correction),a;
      if(correction){
        a=application_(cleanText_(data.values.applicationId));
        if(!event.applicationId){
          validateCorrection_(a,data.values,cfg);
          assert_(!rows_('Eventos').some(function(prior){return prior.applicationId===a.id&&prior.formId===formId&&prior.status!=='DONE';}),'Existe una subsanación en proceso. Tesorería debe resolver ese envío primero.');
          event.applicationId=a.id;event.revision=Number(a.revision)+1;put_('Eventos',event);
        }
      }else{
        var valid=validateApplication_(data.values,cfg);
        if(event.applicationId)a=application_(event.applicationId);
        else{
          a=find_('Solicitudes','initialResponseId',response.getId());
          if(a){event.applicationId=a.id;event.revision=1;put_('Eventos',event);}
          else a=rows_('Solicitudes').find(function(r){return r.period===cfg.ACADEMIC_PERIOD&&r.identityType===valid.identityType&&r.identityNumber===valid.identityNumber;});
          if(a&&a.initialResponseId!==response.getId()){event.applicationId=a.id;event.revision=a.revision;event.status='DONE';event.error='DUPLICATE_APPLICATION';put_('Eventos',event);audit_(UMA.owner,'DUPLICATE_SUBMISSION',a.id,'Envío '+response.getId()+' conservado en respuestas originales; use subsanación');return a.id;}
          if(!a){
          a=Object.assign(valid,{id:nextId_(),createdAt:response.getTimestamp().toISOString(),updatedAt:now_(),period:cfg.ACADEMIC_PERIOD,initialResponseId:response.getId(),revision:1,version:1,status:'RECIBIDA',emailStatus:''});
          saveApplication_(a);event.applicationId=a.id;event.revision=1;put_('Eventos',event);
          }
        }
      }
      // A saved incomplete event resumes the same application/revision.
      assert_(data.values.signed&&data.values.consent,'Falta confirmación de firma o privacidad');
      copyDocuments_(a,data.uploads,Number(event.revision));
      if(correction){
        var alreadyCommitted=Number(a.revision)===Number(event.revision);
        a.revision=Number(event.revision);if(!alreadyCommitted)a.version=Number(a.version)+1;a.lastCorrectionAt=a.lastCorrectionAt||now_();a.correctionExpiresAt='';
        transition_(a,'CORRECCION_RECIBIDA',a.recipient,cleanText_(data.values.clarification),key+':status');
      }else if(!find_('Historial_Estados','key',key+':status'))transition_(a,'RECIBIDA',UMA.owner,'Recepción inicial',key+':status');
      a.processingError='';saveApplication_(a);event.status='DONE';event.error='';event.retryAt='';put_('Eventos',event);audit_(UMA.owner,correction?'CORRECTION_RECEIVED':'APPLICATION_RECEIVED',a.id,'Revisión '+a.revision);return a.id;
    }catch(e){
      event.status='ERROR';event.error=String(e.message);event.retryAt=new Date(Date.now()+Math.min(86400000,600000*Math.pow(2,Math.min(8,event.attempts-1)))).toISOString();put_('Eventos',event);
      if(event.applicationId){try{var failed=application_(event.applicationId);failed.processingError=e.message;saveApplication_(failed);}catch(_){}}
      error_('FORM_SUBMIT',key,e);throw e;
    }
  });
}
function correctionToken_(a) {
  var message=[a.id,a.correctionRevision,a.correctionExpiresAt].join('|');
  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(message,config_().CORRECTION_SECRET)).replace(/=+$/,'');
}
function constantEqual_(a,b){a=String(a||'');b=String(b||'');var diff=a.length^b.length;for(var i=0;i<Math.max(a.length,b.length);i++)diff|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return diff===0;}
function validateCorrection_(a,v,cfg) {
  assert_(a.status==='OBSERVADA','La solicitud no admite subsanación');
  assert_(Date.parse(a.correctionExpiresAt)>Date.now(),'El enlace de subsanación venció. Contacte a Tesorería.');
  assert_(constantEqual_(correctionToken_(a),v.token),'Código de subsanación inválido');
  assert_(normalizeEmail_(v.institutionalEmail)===a.institutionalEmail&&cleanText_(v.identityNumber)===String(a.identityNumber),'Los datos no corresponden al expediente');
}
function correctionUrl_(a) {
  var f=FormApp.openById(config_().CORRECTION_FORM_ID),map=JSON.parse(config_().CORRECTION_QUESTION_MAP),r=f.createResponse();
  // Keep identity numbers and email addresses out of URL history/referrers.
  [['applicationId',a.id],['token',correctionToken_(a)]].forEach(function(pair){r.withItemResponse(f.getItemById(Number(map[pair[0]])).asTextItem().createResponse(String(pair[1])));});
  return r.toPrefilledUrl();
}
/** Owner recovery job: no emails or reviews are inferred from edited cells. */
function reconcileSubmissions(e) {
  owner_(e,'reconcileSubmissions');var cfg=config_(),p=properties_();
  locked_(recoverDecisions_);
  [false,true].forEach(function(correction){
    var key=correction?'CORRECTION_FORM_ID':'GOOGLE_FORM_ID',cursorKey='CURSOR_'+key;
    var since=Number(p.getProperty(cursorKey)||0),cutoff=Date.now();
    var responses=FormApp.openById(cfg[key]).getResponses(new Date(Math.max(0,since-60000)));
    // Bound work per execution; only advance after every response in this interval was considered.
    var known=rows_('Eventos'),processed=0;for(var i=0;i<responses.length;i++){
      var prior=known.find(function(event){return event.formId===cfg[key]&&event.responseId===responses[i].getId();});
      if(prior&&(prior.status==='DONE'||prior.status==='ERROR'))continue;
      if(processed>=40)return;
      try{ingest_(responses[i],correction);}catch(e){/* persisted error; retried separately below */}processed++;
    }
    p.setProperty(cursorKey,String(cutoff));
    rows_('Eventos').filter(function(e){return e.formId===cfg[key]&&e.status!=='DONE'&&(!e.retryAt||Date.parse(e.retryAt)<=Date.now());}).sort(function(a,b){return String(a.attemptedAt||'').localeCompare(String(b.attemptedAt||''));}).slice(0,5).forEach(function(e){try{ingest_(FormApp.openById(cfg[key]).getResponse(e.responseId),correction);}catch(_){}});
  });
}
function retryFailedEvent(key){
  owner_();var event=find_('Eventos','key',key);assert_(event&&event.status!=='DONE','No hay un evento pendiente');
  assert_([config_().GOOGLE_FORM_ID,config_().CORRECTION_FORM_ID].indexOf(event.formId)>=0,'Formulario no autorizado');
  audit_(UMA.owner,'EVENT_RETRY',event.applicationId,event.key);
  return ingest_(FormApp.openById(event.formId).getResponse(event.responseId),event.formId===config_().CORRECTION_FORM_ID);
}
